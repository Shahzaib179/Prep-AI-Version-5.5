# Prep.AI settings. Copy to .env for local runs, or add the same names to Streamlit Cloud -> Settings -> Secrets
# (see secrets.example.toml). Never commit real values.

GROQ_API_KEY=your_groq_api_key_here
# Needed once by each tutor when creating a tutor account. Choose a long private code.
TUTOR_ACCESS_CODE=choose-a-private-tutor-code
# Leave empty to use the local SQLite file (data/prep_ai.db). For a permanent database use Supabase's "Transaction pooler" URL.
DATABASE_URL=
# Optional
DB_POOL_MAX=5
ENABLE_PERSISTENT_LOGIN=false
REMINDER_PROVIDER=dry_run
